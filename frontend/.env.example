# URL of the FastAPI backend. Local dev default assumes:
#   uvicorn app.main:app --reload   (from backend/, defaults to port 8000)
VITE_API_BASE_URL=http://localhost:8000

# After deploying the backend to Render, set this in Vercel's project
# settings to something like:
# VITE_API_BASE_URL=https://forecast-evidence-api.onrender.com
